# ── PAJES backend environment (copy to .env and fill in) ──────────────────────

# Application
APP_NAME="PAJES API"
APP_ENV=development
APP_DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174,http://localhost:4173
SECURE_COOKIES=false

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://pajes_admin:pajes_password@localhost:5432/pajes_dev
DB_HOST=localhost
DB_PORT=5432
DB_USER=pajes_admin
DB_PASSWORD=change_me
DB_NAME=pajes_dev

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600
DB_POOL_PRE_PING=true

# ── Auth / sessions ───────────────────────────────────────────────────────────
AUTH_SECRET_KEY=change_this_to_a_long_random_secret
AUTH_COOKIE_NAME=pajes_session
AUTH_SESSION_TTL_MINUTES=480
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=2

# ── Rate limiting ─────────────────────────────────────────────────────────────
LOGIN_RATE_LIMIT_PER_MINUTE=10
LOGIN_RATE_WINDOW_SECONDS=60

# ── CSRF ──────────────────────────────────────────────────────────────────────
CSRF_ENABLED=true
CSRF_COOKIE_NAME=pajes_csrf
CSRF_HEADER_NAME=X-CSRF-Token

# ── Email (transactional provider, configurable) ─────────────────────────────
EMAIL_PROVIDER=none
EMAIL_FROM_ADDRESS=noreply@excimaa.com
EMAIL_FROM_NAME=PAJES
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SENDGRID_API_KEY=
POSTMARK_API_KEY=
FRONTEND_URL=http://127.0.0.1:5174

# ── File storage ───────────────────────────────────────────────────────────────
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT_URL=
S3_REGION=
S3_BUCKET_NAME=
S3_ACCESS_KEY=
S3_SECRET_KEY=
STORAGE_MAX_UPLOAD_BYTES=20971520

# ── Power BI Embedded ──────────────────────────────────────────────────────────
POWERBI_TENANT_ID=
POWERBI_CLIENT_ID=
POWERBI_CLIENT_SECRET=
POWERBI_WORKSPACE_ID=
POWERBI_DEFAULT_REPORT_ID=
POWERBI_REPORT_IDS=
POWERBI_DATASET_ID=
POWERBI_RLS_ROLE=
